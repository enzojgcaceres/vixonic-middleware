# Token de acceso de la app de Intercom (Developer Hub > tu app > Authentication)
INTERCOM_ACCESS_TOKEN=

# ID del admin que va a figurar como responsable de la remocion de participantes
# Ese admin necesita el permiso "Can manage conversation participants" habilitado
INTERCOM_ADMIN_ID=

# Region del workspace: us (default), eu, au
INTERCOM_REGION=us

# Dominios propios (separados por coma), nunca se dejan como "el cliente"
# aunque figuren como source.author o sean el unico participante restante.
# Necesario para conversaciones que arranca un agente (mail saliente a
# varios destinatarios en To/Cc) -- ver src/customerResolver.js
INTERNAL_DOMAINS=vixonic.com

# Secret compartido para validar que la llamada al webhook viene de Intercom
# (lo definis vos y lo pegas en el header custom que configures en el step "Wait for Webhook")
WEBHOOK_SHARED_SECRET=

PORT=3000
